{
	"name": "jmbarne3/simple-nws-weather-block",
	"description": "Development tooling for Simple NWS Weather Block. Nothing here ships with the plugin.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"php": ">=7.4",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"johnbillion/wp-compat": "^2.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1 || ^3.0@alpha",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"platform": {
			"php": "7.4.33"
		},
		"sort-packages": true
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
