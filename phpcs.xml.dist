<?xml version="1.0"?>
<ruleset name="Simple NWS Weather Block PHP compatibility">
	<description>Fails if the PHP code uses syntax or functions newer than the plugin's "Requires PHP" header. The minimum is read from the header by utils/check-php.mjs.</description>

	<file>simple-nws-weather-block.php</file>
	<file>includes</file>
	<file>src/weather/render.php</file>
	<file>src/weather/partials</file>
	<file>tests/php</file>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
