# Keeps GitHub's auto-generated release archives ("Source code (zip)") down to
# the files that actually make up the plugin. GitHub builds those with
# `git archive`, which honours `export-ignore`, so this is the .gitattributes
# counterpart to .distignore -- the two lists should be kept in step.
#
# Only tracked files matter here, so build artefacts and node_modules need no
# entry. Patterns use gitignore syntax; a leading slash anchors to the plugin
# root.
#
# Note that the WordPress.org deploy workflow does NOT use this file: the 10up
# action prefers .distignore when one exists, and one does.

# Version control and CI
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.wordpress-org     export-ignore

# Sources -- build/ is what actually runs
/src                export-ignore
/utils              export-ignore

# Tooling config
/.distignore        export-ignore
/.editorconfig      export-ignore
/.stylelintignore   export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore

# Contributor-facing docs; readme.txt is the user-facing one
/README.md          export-ignore
